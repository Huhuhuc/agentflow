# Copy to backend/.env only if you do not already have that file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# Business Agent uses the explicit UI mode; leave workflow nodes in Mock by default.
LLM_MODE=mock
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
# Optional local retrieval experiment. Default is lexical; hybrid requires a ready
# tenant policy index and matching local embedding revision.
RETRIEVAL_MODE=lexical
# Set only after calibrating on reviewed tenant data; omitted means no score abstention.
# RETRIEVAL_ABSTENTION_THRESHOLD=0.52
RETRIEVAL_MIN_INDEX_COVERAGE=1.0
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=5.0
EMBEDDING_MODEL_PATH=
EMBEDDING_REVISION=
